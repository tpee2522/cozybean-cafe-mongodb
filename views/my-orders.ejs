<%- include('partials/header') %>

<h3 class="fw-bold mb-4">🧾 ประวัติการสั่งซื้อของคุณ (<%= currentUser.name %>)</h3>

<% if (orders.length === 0) { %>
  <div class="card shadow-sm p-5 text-center">
    <p class="text-muted mb-3">คุณยังไม่มีประวัติการสั่งซื้อ</p>
    <div><a href="/" class="btn btn-dark">เลือกดูเมนูเครื่องดื่ม</a></div>
  </div>
<% } else { %>
  <div class="card shadow-sm p-4">
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead class="table-dark">
          <tr>
            <th>วันที่สั่งซื้อ</th>
            <th>รายการเมนู</th>
            <th>สถานที่จัดส่ง / โต๊ะ</th>
            <th>ยอดรวม</th>
            <th>วิธีชำระเงิน</th>
            <th>สถานะออเดอร์</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td><%= new Date(o.createdAt).toLocaleString('th-TH') %></td>
              <td>
                <ul class="mb-0 ps-3">
                  <% o.items.forEach(i => { %>
                    <li><%= i.name %> x <%= i.qty %> (<%= i.price %> ฿)</li>
                  <% }) %>
                </ul>
              </td>
              <td><%= o.address %></td>
              <td class="fw-bold text-danger"><%= o.totalAmount.toLocaleString() %> ฿</td>
              <td><%= o.paymentMethod || 'เงินสด / ชำระที่เคาน์เตอร์' %></td>
              <td>
                <% if (o.status === 'ได้รับออเดอร์แล้ว') { %>
                  <span class="badge bg-success fs-6">✅ ร้านได้รับออเดอร์แล้ว (กำลังเตรียม)</span>
                <% } else if (o.status === 'จัดส่งสำเร็จ / พร้อมรับสินค้า') { %>
                  <span class="badge bg-primary fs-6">🎉 จัดส่งสำเร็จ / พร้อมรับสินค้า</span>
                <% } else { %>
                  <span class="badge bg-warning text-dark fs-6">⏳ <%= o.status %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
