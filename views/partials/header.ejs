<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CozyBean Café - ร้านคาเฟ่ออนไลน์ MongoDB</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-light d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark shadow-sm mb-4" style="background-color: #3e2723;">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">☕ CozyBean Café</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
        <li class="nav-item"><a class="nav-link" href="/">เมนูหน้าร้าน</a></li>
        <li class="nav-item">
          <a class="btn btn-warning btn-sm fw-bold" href="/cart">
            🛒 ตะกร้าสินค้า <span class="badge bg-dark text-white"><%= cartCount %></span>
          </a>
        </li>
        <% if (isAdmin) { %>
          <li class="nav-item"><a class="btn btn-info btn-sm" href="/admin">⚙️ จัดการร้าน (Admin)</a></li>
          <li class="nav-item">
            <form action="/admin/logout" method="POST" class="d-inline">
              <button class="btn btn-danger btn-sm">ออกจากระบบ</button>
            </form>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="btn btn-outline-light btn-sm" href="/admin/login">เข้าสู่ระบบ Admin</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
<main class="container flex-grow-1">
