<%- include('partials/header') %>

<div class="card shadow-sm p-4">
  <div class="row g-4 align-items-center">
    <div class="col-md-5 text-center">
      <img src="<%= product.image %>" class="img-fluid rounded" alt="<%= product.name %>">
    </div>
    <div class="col-md-7">
      <span class="badge bg-secondary mb-2"><%= product.category %></span>
      <h2 class="fw-bold"><%= product.name %></h2>
      <p class="text-muted mt-3"><%= product.description %></p>
      <h3 class="text-danger fw-bold my-3"><%= product.price.toLocaleString() %> บาท</h3>
      <p>สถานะสินค้า: <strong><%= product.stock > 0 ? `พร้อมเสิร์ฟ (${product.stock} รายการ)` : 'สินค้าหมด' %></strong></p>
      <div class="d-flex gap-2 mt-4">
        <a href="/" class="btn btn-outline-secondary">← กลับหน้าเมนู</a>
        <% if (product.stock > 0) { %>
          <form action="/cart/add/<%= product._id %>" method="POST">
            <button type="submit" class="btn btn-success">🛒 หยิบใส่ตะกร้า</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
