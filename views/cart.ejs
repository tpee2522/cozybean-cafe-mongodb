<form action="/checkout" method="POST">
  <div class="mb-2">
    <label class="form-label">ชื่อลูกค้า</label>
    <input type="text" name="customerName" class="form-control" value="<%= currentUser ? currentUser.name : '' %>" required>
  </div>
  <div class="mb-2">
    <label class="form-label">เบอร์โทรศัพท์ (ไม่บังคับ)</label>
    <input type="text" name="phone" class="form-control" value="<%= currentUser ? currentUser.phone : '' %>">
  </div>
  <div class="mb-2">
    <label class="form-label">สถานที่จัดส่ง / หมายเลขโต๊ะ</label>
    <textarea name="address" class="form-control" rows="2" placeholder="เช่น โต๊ะ 5 หรือ 99/9 ถ.แจ้งวัฒนะ จ.นนทบุรี" required></textarea>
  </div>

  <div class="mb-3">
    <label class="form-label fw-bold">💳 วิธีการชำระเงิน</label>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="paymentMethod" id="payCash" value="เงินสด / ชำระที่เคาน์เตอร์" checked>
      <label class="form-check-label" for="payCash">💵 เงินสด / ชำระที่เคาน์เตอร์</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="paymentMethod" id="payQR" value="โอนผ่านธนาคาร / QR PromptPay">
      <label class="form-check-label" for="payQR">📱 โอนผ่านธนาคาร / QR PromptPay</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="paymentMethod" id="payCard" value="บัตรเครดิต / เดบิต">
      <label class="form-check-label" for="payCard">💳 บัตรเครดิต / เดบิต</label>
    </div>

    <!-- กล่องแสดง QR Code อัตโนมัติเมื่อเลือกชำระผ่าน QR PromptPay -->
    <div id="qrBox" class="mt-2 p-3 border rounded bg-light text-center d-none">
      <small class="d-block fw-bold mb-2 text-primary">สแกน QR PromptPay เพื่อชำระเงิน (<%= totalAmount.toLocaleString() %> บาท)</small>
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=CozyBeanCafe-<%= totalAmount %>THB" alt="QR PromptPay" class="img-thumbnail mb-1">
      <small class="d-block text-muted">ชื่อบัญชี: ร้าน CozyBean Café</small>
    </div>
  </div>

  <button type="submit" class="btn btn-success w-100 fw-bold">ยืนยันการสั่งซื้อ</button>
</form>

<script>
  const qrBox = document.getElementById('qrBox');
  document.querySelectorAll('input[name="paymentMethod"]').forEach(radio => {
    radio.addEventListener('change', () => {
      if (document.getElementById('payQR').checked) {
        qrBox.classList.remove('d-none');
      } else {
        qrBox.classList.add('d-none');
      }
    });
  });
</script>
