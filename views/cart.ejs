<%- include('partials/header') %>

<h3 class="fw-bold mb-4">🛒 ตะกร้าสินค้าของคุณ</h3>

<% if (cartItems.length === 0) { %>
  <div class="alert alert-info">ยังไม่มีเมนูในตะกร้า <a href="/" class="alert-link">เลือกดูเมนูคาเฟ่เลย</a></div>
<% } else { %>
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="table-responsive bg-white rounded shadow-sm p-3">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>เมนู</th>
              <th>ราคา/หน่วย</th>
              <th>จำนวน</th>
              <th>รวม</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% cartItems.forEach(item => { %>
              <tr>
                <td><%= item.product.name %></td>
                <td><%= item.product.price.toLocaleString() %> ฿</td>
                <td>
                  <div class="d-flex align-items-center gap-1">
                    <form action="/cart/decrease/<%= item.product._id %>" method="POST" class="d-inline">
                      <button class="btn btn-outline-secondary btn-sm">-</button>
                    </form>
                    <span class="px-2 fw-bold"><%= item.qty %></span>
                    <form action="/cart/add/<%= item.product._id %>" method="POST" class="d-inline">
                      <button class="btn btn-outline-secondary btn-sm">+</button>
                    </form>
                  </div>
                </td>
                <td class="fw-bold"><%= item.subtotal.toLocaleString() %> ฿</td>
                <td>
                  <form action="/cart/remove/<%= item.product._id %>" method="POST">
                    <button class="btn btn-outline-danger btn-sm">ลบ</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm p-4">
        <h5 class="fw-bold">สรุปรายการสั่งซื้อ</h5>
        <h4 class="text-danger fw-bold my-3">ยอดสุทธิ: <%= totalAmount.toLocaleString() %> บาท</h4>
        <hr>
        <form action="/checkout" method="POST">
          <div class="mb-2">
            <div class="mb-2">
  <label class="form-label">ชื่อลูกค้า</label>
  <input type="text" name="customerName" class="form-control" value="<%= currentUser ? currentUser.name : '' %>" required>
</div>
<div class="mb-2">
  <label class="form-label">เบอร์โทรศัพท์ (ไม่บังคับ)</label>
  <input type="text" name="phone" class="form-control" value="<%= currentUser ? currentUser.phone : '' %>">
</div>
          </div>
          <div class="mb-3">
            <label class="form-label">สถานที่จัดส่ง / หมายเลขโต๊ะ</label>
            <textarea name="address" class="form-control" rows="2" placeholder="เช่น โต๊ะ 5 หรือ 99/9 ถ.แจ้งวัฒนะ จ.นนทบุรี" required></textarea>
          </div>
          <button type="submit" class="btn btn-success w-100 fw-bold">ยืนยันการสั่งซื้อ</button>
        </form>
      </div>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
