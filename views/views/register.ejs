<%- include('partials/header') %>

<div class="card shadow-sm p-4 mx-auto" style="max-width: 450px;">
  <h4 class="fw-bold text-center mb-3">📝 สมัครสมาชิก CozyBean Café</h4>
  <% if (error) { %>
    <div class="alert alert-danger py-2"><%= error %></div>
  <% } %>
  <form action="/register" method="POST">
    <div class="mb-3">
      <label class="form-label">ชื่อ - นามสกุล (หรือชื่อเล่น)</label>
      <input type="text" name="name" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">เบอร์โทรศัพท์</label>
      <input type="text" name="phone" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">อีเมล</label>
      <input type="email" name="email" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">รหัสผ่าน</label>
      <input type="password" name="password" class="form-control" minlength="4" required>
    </div>
    <button type="submit" class="btn btn-success w-100 fw-bold">สมัครสมาชิก</button>
  </form>
  <div class="text-center mt-3">
    <small>มีบัญชีอยู่แล้ว? <a href="/login">เข้าสู่ระบบที่นี่</a></small>
  </div>
</div>

<%- include('partials/footer') %>
