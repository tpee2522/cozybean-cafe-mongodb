<%- include('partials/header') %>

<div class="card shadow-sm p-4 mx-auto" style="max-width: 420px;">
  <h4 class="fw-bold text-center mb-3">☕ เข้าสู่ระบบสมาชิก</h4>
  <% if (error) { %>
    <div class="alert alert-danger py-2"><%= error %></div>
  <% } %>
  <form action="/login" method="POST">
    <div class="mb-3">
      <label class="form-label">อีเมล</label>
      <input type="email" name="email" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">รหัสผ่าน</label>
      <input type="password" name="password" class="form-control" required>
    </div>
    <button type="submit" class="btn btn-dark w-100 fw-bold">เข้าสู่ระบบ</button>
  </form>
  <div class="text-center mt-3">
    <small>ยังไม่มีบัญชี? <a href="/register">สมัครสมาชิกใหม่</a></small>
  </div>
</div>

<%- include('partials/footer') %>
